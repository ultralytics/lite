{
  "name": "lite",
  "description": "A fast, local workspace for AI coding agents.",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.14"
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "vite",
    "build": "tsgo --noEmit && vite build",
    "preview": "vite preview",
    "test": "bun test",
    "tauri": "tauri",
    "local": "tauri build --bundles app --config '{\"productName\":\"Lite Dev\",\"identifier\":\"com.ultralytics.lite.dev\",\"bundle\":{\"createUpdaterArtifacts\":false,\"icon\":[\"icons/dev/32x32.png\",\"icons/dev/128x128.png\",\"icons/dev/128x128@2x.png\",\"icons/dev/icon.icns\",\"icons/dev/icon.ico\"]}}'",
    "check": "bun run lint && bun run typecheck && bun run deadcode",
    "deadcode": "knip",
    "format": "biome check --write .",
    "lint": "biome check . --diagnostic-level=error",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@fontsource-variable/geist": "^5.3.0",
    "@lezer/highlight": "^1.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.11.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.33.0",
    "material-icon-theme": "^5.37.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.3",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^6.1.0",
    "knip": "^6.32.2",
    "vite": "^8.2.2"
  },
  "overrides": {
    "@codemirror/view": "6.43.8"
  },
  "knip": {
    "ignoreDependencies": [
      "@fontsource-variable/geist",
      "material-icon-theme"
    ]
  }
}
